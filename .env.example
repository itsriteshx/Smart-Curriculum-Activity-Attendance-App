# ==========================================
# SMART AGRICULTURAL ADVISORY SYSTEM - ENV CONFIG
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB URI)
# For local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/smart_agriculture_db
# For MongoDB Atlas (uncomment and replace credentials):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_agriculture_db?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=supersecret_agri_advisor_jwt_key_2026_dev_secure
JWT_EXPIRE=7d

# Weather API (OpenWeatherMap)
# Sign up at https://openweathermap.org/api to get a free API key
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
