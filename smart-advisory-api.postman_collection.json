{
  "info": {
    "name": "Smart Agricultural Advisory System API - Day 2 Suite",
    "description": "Comprehensive Postman Collection covering Day 1 and Day 2 endpoints for Crop Recommendations, Soil Health Diagnostics, Fertilizer Calculation, Pest Detection Image Upload, Mandi Market Rates, and Admin Analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. System & Health",
      "item": [
        {
          "name": "Root Endpoints Manifest",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register Farmer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ramesh Patel\",\n  \"email\": \"ramesh.patel@kisan.in\",\n  \"password\": \"FarmerSecurePass123\",\n  \"phoneNumber\": \"9876543210\",\n  \"userRole\": \"farmer\"\n}"
            }
          }
        },
        {
          "name": "Login Farmer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ramesh.patel@kisan.in\",\n  \"password\": \"FarmerSecurePass123\"\n}"
            }
          }
        },
        {
          "name": "Get Authenticated Profile (Me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }]
          }
        }
      ]
    },
    {
      "name": "3. Crop Recommendation Engine",
      "item": [
        {
          "name": "Get Top 5 Crop Recommendations for Farmer",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/crops/recommend/673f8e912345678901234567"
          }
        },
        {
          "name": "Get Specific Crop Agronomic Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/crops/wheat"
          }
        },
        {
          "name": "Get Crops Suitable for Region",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/crops/region/Punjab/Ludhiana"
          }
        },
        {
          "name": "Get Seasonal Crops (Kharif / Rabi / Zaid)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/crops/seasonal/Kharif"
          }
        }
      ]
    },
    {
      "name": "4. Soil Health & Fertilizer Calculator",
      "item": [
        {
          "name": "Submit Soil Test Analysis",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/soil/analyze",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmerId\": \"673f8e912345678901234567\",\n  \"nitrogen\": 240,\n  \"phosphorus\": 8,\n  \"potassium\": 105,\n  \"pH\": 6.8,\n  \"organicMatter\": 0.65\n}"
            }
          }
        },
        {
          "name": "Get Precise Fertilizer Dosage Plan (Urea / DAP / MOP)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/soil/fertilizer-recommendation/673f8e912345678901234567/wheat"
          }
        },
        {
          "name": "Get Soil Audit History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/soil/analysis/673f8e912345678901234567"
          }
        },
        {
          "name": "Check / Set Annual Soil Test Reminder",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/soil/set-reminder/673f8e912345678901234567"
          }
        }
      ]
    },
    {
      "name": "5. Pest & Disease Diagnostics",
      "item": [
        {
          "name": "Upload Crop Leaf Photo for Pest Diagnosis",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/pest/detect",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "" },
                { "key": "cropName", "value": "wheat", "type": "text" },
                { "key": "symptoms", "value": "yellow powder and stripes along leaves", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "Get Treatment Guidelines (Organic + Chemical)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pest/treatment/Yellow%20Rust/wheat"
          }
        },
        {
          "name": "Calculate Spraying & Treatment Cost for Farm Size",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pest/cost/Yellow%20Rust/4.5"
          }
        },
        {
          "name": "Manual Incident Log",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/pest/report",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmerId\": \"673f8e912345678901234567\",\n  \"cropName\": \"rice\",\n  \"symptoms\": \"dead hearts at vegetative stage\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "6. Mandi Market Prices & Alerts",
      "item": [
        {
          "name": "Get Current APMC Mandi Price",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/market/prices/wheat/Punjab/Ludhiana"
          }
        },
        {
          "name": "Get 30-Day Historical Trend & Volatility",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/market/history/wheat?days=30"
          }
        },
        {
          "name": "Get Buy / Sell Market Intelligence Advisory",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/market/sell-recommendation/wheat/673f8e912345678901234567"
          }
        },
        {
          "name": "Subscribe to Price Alert",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/market/alert/create",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmerId\": \"673f8e912345678901234567\",\n  \"cropName\": \"wheat\",\n  \"alertType\": \"good_price\",\n  \"targetPrice\": 2600\n}"
            }
          }
        }
      ]
    },
    {
      "name": "7. Admin Analytics Dashboard",
      "item": [
        {
          "name": "Get Macro Analytics Dashboard (Admin Only)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/stats",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminJwtToken}}" }]
          }
        },
        {
          "name": "Get Active Farmers Count & Demographics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/farmers/count",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminJwtToken}}" }]
          }
        },
        {
          "name": "Get Top Recommended Crops Breakdown",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/crops/recommendations",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminJwtToken}}" }]
          }
        }
      ]
    },
    {
      "name": "8. Feedback & Ratings",
      "item": [
        {
          "name": "Submit Advisory Rating & Review",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/feedback",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farmerId\": \"673f8e912345678901234567\",\n  \"rating\": 5,\n  \"category\": \"crop\",\n  \"comment\": \"The wheat recommendation and fertilizer dosage saved 2 bags of DAP!\"\n}"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "jwtToken", "value": "" },
    { "key": "adminJwtToken", "value": "" }
  ]
}
